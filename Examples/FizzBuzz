n = 1

while n <= 100

    r3 = n % 3
    r5 = n % 5

    fizz = r3 == 0
    buzz = r5 == 0

    code = fizz * 2 + buzz

    if code == 3
        print 'FizzBuzz'
    endif

    if code == 2
        print 'Fizz'
    endif

    if code == 1
        print 'Buzz'
    endif

    if code == 0
        print n
    endif

    n = n + 1

endwhile